<Page x:Name="Page" 
	  x:Class="ForzaUI.Scenes.WPF.F000_Splash"
      xmlns:local="clr-namespace:ForzaUI"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      mc:Ignorable="d"
      DataContext="{Binding RelativeSource={x:Static RelativeSource.Self}}"
      Background="{StaticResource AlmostBlackBrush}">
	
    
    <Page.Resources>
    	<Storyboard x:Key="TransitionIn">
            <StringAnimationUsingKeyFrames Storyboard.TargetProperty="(local:EventFire.EventName)" Storyboard.TargetName="EventFireStoryboard">
                <DiscreteStringKeyFrame KeyTime="0:0:0.2" Value="startAmbientEvent"/>
                <DiscreteStringKeyFrame KeyTime="0:0:0.467" Value="ButtonGlowEvent"/>
            </StringAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="LayoutRoot">
    			<EasingDoubleKeyFrame KeyTime="0" Value="1"/>
    		</DoubleAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="StackPanel_HelpButton">
    			<EasingDoubleKeyFrame KeyTime="0" Value="0"/>
    			<EasingDoubleKeyFrame KeyTime="0:0:1.1" Value="0"/>
    			<EasingDoubleKeyFrame KeyTime="0:0:1.267" Value="1"/>
    		</DoubleAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_Bg">
    			<EasingDoubleKeyFrame KeyTime="0" Value="0"/>
    			<EasingDoubleKeyFrame KeyTime="0:0:1.1" Value="0"/>
    			<EasingDoubleKeyFrame KeyTime="0:0:1.6" Value="1"/>
    		</DoubleAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_BackgroundGradient1">
    			<EasingDoubleKeyFrame KeyTime="0" Value="1"/>
    		</DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)" Storyboard.TargetName="Grid_ForzaStripe">
        		<EasingDoubleKeyFrame KeyTime="0" Value="-540"/>
        		<EasingDoubleKeyFrame KeyTime="0:0:0.267" Value="0"/>
        	</DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" Storyboard.TargetName="Grid_ForzaStripe">
        		<EasingDoubleKeyFrame KeyTime="0" Value="0.05"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.267" Value="0.05"/>
        		<EasingDoubleKeyFrame KeyTime="0:0:0.467" Value="1"/>
        	</DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Grid_ForzaStripe">
    			<EasingDoubleKeyFrame KeyTime="0" Value="0"/>
    			<EasingDoubleKeyFrame KeyTime="0:0:0.167" Value="1"/>
    		</DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)" Storyboard.TargetName="Image_LogoForza">
        		<EasingDoubleKeyFrame KeyTime="0" Value="-200"/>
        		<EasingDoubleKeyFrame KeyTime="0:0:0.467" Value="-200"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.933" Value="0" KeySpline="0,0,0,1"/>
        	</DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_LogoForza">
        		<EasingDoubleKeyFrame KeyTime="0" Value="0"/>
        		<EasingDoubleKeyFrame KeyTime="0:0:0.467" Value="0"/>
        		<EasingDoubleKeyFrame KeyTime="0:0:0.633" Value="1"/>
        	</DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)" Storyboard.TargetName="Image_LogoForzaText">
        		<EasingDoubleKeyFrame KeyTime="0" Value="200"/>
        		<EasingDoubleKeyFrame KeyTime="0:0:0.467" Value="200"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.933" Value="0" KeySpline="0,0,0,1"/>
        	</DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_LogoForzaText">
        		<EasingDoubleKeyFrame KeyTime="0" Value="0"/>
        		<EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="0"/>
        		<EasingDoubleKeyFrame KeyTime="0:0:0.933" Value="1"/>
        	</DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_ForzaShadow">
            	<EasingDoubleKeyFrame KeyTime="0" Value="0"/>
            	<EasingDoubleKeyFrame KeyTime="0:0:1.1" Value="0"/>
            	<EasingDoubleKeyFrame KeyTime="0:0:1.6" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_Vignette">
            	<EasingDoubleKeyFrame KeyTime="0" Value="0"/>
            	<EasingDoubleKeyFrame KeyTime="0:0:1.1" Value="0"/>
            	<EasingDoubleKeyFrame KeyTime="0:0:1.6" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
    	</Storyboard> <!-- TransitionIn -->
        
        <Storyboard x:Key="OpaqueTransitionIn">
            <StringAnimationUsingKeyFrames Storyboard.TargetProperty="(local:EventFire.EventName)" Storyboard.TargetName="EventFireStoryboard">
                <DiscreteStringKeyFrame KeyTime="0:0:0.2" Value="startAmbientEvent"/>
                <DiscreteStringKeyFrame KeyTime="0:0:0.467" Value="ButtonGlowEvent"/>
            </StringAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="LayoutRoot">
    			<EasingDoubleKeyFrame KeyTime="0" Value="1"/>
    		</DoubleAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="StackPanel_HelpButton">
    			<EasingDoubleKeyFrame KeyTime="0" Value="0"/>
    			<EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0"/>
    			<EasingDoubleKeyFrame KeyTime="0:0:0.767" Value="1"/>
    		</DoubleAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_LogoForza">
    			<EasingDoubleKeyFrame KeyTime="0" Value="1"/>
    		</DoubleAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_Bg">
    			<EasingDoubleKeyFrame KeyTime="0" Value="1"/>
    		</DoubleAnimationUsingKeyFrames>
    	</Storyboard> <!-- TransitionIn -->
		
		<Storyboard x:Key="WaitForSignIn">
			<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="IdleIndicator">
    			<EasingDoubleKeyFrame KeyTime="0" Value="1"/>
    		</DoubleAnimationUsingKeyFrames>
			<StringAnimationUsingKeyFrames Storyboard.TargetProperty="(local:EventFire.EventName)" Storyboard.TargetName="IdleEventFireSpin">
                <DiscreteStringKeyFrame KeyTime="0" Value="Idle_Start"/>
            </StringAnimationUsingKeyFrames>
			<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="StackPanel_HelpButton">
    			<EasingDoubleKeyFrame KeyTime="0" Value="0"/>
    		</DoubleAnimationUsingKeyFrames>
		</Storyboard>
        
    	<Storyboard x:Key="TransitionOut">
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_ButtonA">
    			<EasingDoubleKeyFrame KeyTime="0" Value="1"/>
    			<EasingDoubleKeyFrame KeyTime="0:0:0.167" Value="0.25"/>
    			<EasingDoubleKeyFrame KeyTime="0:0:0.333" Value="1"/>
    		</DoubleAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="LayoutRoot">
    			<EasingDoubleKeyFrame KeyTime="0" Value="1"/>
    			<DiscreteDoubleKeyFrame KeyTime="0:0:0.367" Value="1"/>
    		</DoubleAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_LogoForza">
    			<EasingDoubleKeyFrame KeyTime="0:0:0.333" Value="1"/>
    			<EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
    		</DoubleAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Grid_Alignment">
    			<EasingDoubleKeyFrame KeyTime="0:0:0.333" Value="1"/>
    			<EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
    		</DoubleAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_Bg">
    			<EasingDoubleKeyFrame KeyTime="0:0:0.333" Value="1"/>
    			<EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
    		</DoubleAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_LogoForzaText">
    			<EasingDoubleKeyFrame KeyTime="0:0:0.333" Value="1"/>
    			<EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
    		</DoubleAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_Ambient_ForzaStripe">
    			<EasingDoubleKeyFrame KeyTime="0:0:0.167" Value="0"/>
    		</DoubleAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_Vignette">
    			<EasingDoubleKeyFrame KeyTime="0:0:0.167" Value="0"/>
    		</DoubleAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_Hilite2">
    			<EasingDoubleKeyFrame KeyTime="0:0:0.167" Value="0"/>
    		</DoubleAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_Hilite1">
    			<EasingDoubleKeyFrame KeyTime="0:0:0.167" Value="0"/>
    		</DoubleAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_ForzaShadow">
    			<EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0"/>
    		</DoubleAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)" Storyboard.TargetName="Grid_ForzaStripe">
    			<EasingDoubleKeyFrame KeyTime="0:0:0.233" Value="0"/>
    			<SplineDoubleKeyFrame KeyTime="0:0:0.567" Value="707" KeySpline="0.3,0,1,1"/>
    		</DoubleAnimationUsingKeyFrames>
    	</Storyboard><!-- TransitionOut -->
        
    	<Storyboard x:Key="Ambient_Storyboard" RepeatBehavior="Forever" Duration="0:0:30">
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)" Storyboard.TargetName="Image_Ambient_ForzaStripe">
    			<EasingDoubleKeyFrame KeyTime="0" Value="0"/>
    			<EasingDoubleKeyFrame KeyTime="0:0:9" Value="870"/>
    		</DoubleAnimationUsingKeyFrames>
    		<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" Storyboard.TargetName="Image_Ambient_ForzaStripe">
    			<EasingDoubleKeyFrame KeyTime="0" Value="0.45"/>
    			<EasingDoubleKeyFrame KeyTime="0:0:2" Value="1"/>
    			<EasingDoubleKeyFrame KeyTime="0:0:6.5" Value="0.45"/>
    			<EasingDoubleKeyFrame KeyTime="0:0:9" Value="0.45"/>
    		</DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_Ambient_ForzaStripe">
    			<EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="0.2"/>
    			<EasingDoubleKeyFrame KeyTime="0:0:2" Value="0.5"/>
    			<EasingDoubleKeyFrame KeyTime="0:0:9" Value="0.2"/>
    		</DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" Storyboard.TargetName="Image_Ambient_ForzaStripe">
            	<EasingDoubleKeyFrame KeyTime="0" Value="0.25"/>
            	<EasingDoubleKeyFrame KeyTime="0:0:2" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_Hilite2">
            	<EasingDoubleKeyFrame KeyTime="0" Value="0"/>
            	<EasingDoubleKeyFrame KeyTime="0:0:0.767" Value="0"/>
            	<EasingDoubleKeyFrame KeyTime="0:0:2.767" Value=".25"/>
            	<EasingDoubleKeyFrame KeyTime="0:0:4.567" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_Hilite1">
            	<EasingDoubleKeyFrame KeyTime="0" Value="0"/>
            	<EasingDoubleKeyFrame KeyTime="0:0:1.333" Value="0"/>
            	<EasingDoubleKeyFrame KeyTime="0:0:3.533" Value="1"/>
            	<EasingDoubleKeyFrame KeyTime="0:0:5.333" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard><!-- Ambient_Storyboard -->
        
        <Storyboard x:Key="Storyboard_ButtonGlow" RepeatBehavior="Forever">
			<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Image_ButtonGlow">
				<EasingDoubleKeyFrame KeyTime="0" Value="0.075"/>
				<EasingDoubleKeyFrame KeyTime="0:0:1" Value="0.40"/>
				<EasingDoubleKeyFrame KeyTime="0:0:2" Value="0.075"/>
			</DoubleAnimationUsingKeyFrames>
		</Storyboard><!-- ButtonGlowStoryboard -->
    <Storyboard x:Key="FailedSignIn">
			<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="IdleIndicator">
				<EasingDoubleKeyFrame KeyTime="0" Value="0"/>
			</DoubleAnimationUsingKeyFrames>
            <StringAnimationUsingKeyFrames Storyboard.TargetProperty="(local:EventFire.EventName)" Storyboard.TargetName="IdleEventFireHideSpin">
            	<DiscreteStringKeyFrame KeyTime="0" Value="Idle_Stop"/>
            </StringAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="StackPanel_HelpButton">
            	<EasingDoubleKeyFrame KeyTime="0" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
		</Storyboard>
    </Page.Resources>
	
    
	<local:EventFire.FzTriggers>
        <local:EventFireTrigger Event="IdleEventFireSetup" Storyboard="{StaticResource WaitForSignIn}"/>
        <local:EventFireTrigger Event="IdleEventFireHideSetup" Storyboard="{StaticResource FailedSignIn}"/>
        <!-- Fired by Storyboards -->
        <local:EventFireTrigger Event="startAmbientEvent" Storyboard="{StaticResource Ambient_Storyboard}"/>
        <local:EventFireTrigger Event="ButtonGlowEvent" Storyboard="{StaticResource Storyboard_ButtonGlow}"/>
    </local:EventFire.FzTriggers>
    
    
	<local:ZPanel x:Name="LayoutRoot" Height="{StaticResource MaxSceneHeight}" Width="{StaticResource MaxSceneWidth}" Opacity="0"><!-- default Opacity="0" -->
        <Image x:Name="Image_BackgroundGradient1" Source="/Textures/Backgrounds/Bg_Start_NoStripes.png"/>
        <Image x:Name="Image_Bg" Source="/Textures/Backgrounds/Bg_Start_E3.png"/>
        <Image x:Name="Image_ForzaShadow" Source="/Textures/Backgrounds/E3_Start_Shadow.png" Opacity="0"/>
        <Grid x:Name="Grid_Body" Height="{StaticResource MaxSceneHeight}" Width="{StaticResource MaxSceneWidth}" >
        	<Grid.RowDefinitions>
        		<RowDefinition Height="*"/>
        		<RowDefinition Height="243"/>
        	</Grid.RowDefinitions>
        	<Grid.ColumnDefinitions>
        		<ColumnDefinition Width="*"/>
        		<ColumnDefinition Width="704"/>
        	</Grid.ColumnDefinitions>
        	<Image x:Name="Image_LogoForza" Source="/Textures/Data_Bound/Logo_FM_Vertical.png" Grid.Column="1" Width="382" HorizontalAlignment="Left" VerticalAlignment="Top" 
                Margin="0,364,0,0" RenderTransformOrigin="0.5,0.5" Clip="M3.2057122E-13,-2 L382,-2 382,124 -2.7836891E-15,124 z">
        		<Image.RenderTransform>
        			<TransformGroup>
        				<ScaleTransform/>
        				<SkewTransform/>
        				<RotateTransform/>
        				<TranslateTransform/>
        			</TransformGroup>
        		</Image.RenderTransform>
        	</Image>
            <Image x:Name="Image_LogoForzaText" Source="/Textures/Data_Bound/Logo_FM_Vertical.png" Grid.Column="1" Width="382" HorizontalAlignment="Left" VerticalAlignment="Top" 
                    Margin="0,364,0,0" RenderTransformOrigin="0.5,0.5" Clip="M2.5867202E-13,133.79904 L382,133.79904 382,245 0,245 z">
        		<Image.RenderTransform>
        			<TransformGroup>
        				<ScaleTransform/>
        				<SkewTransform/>
        				<RotateTransform/>
        				<TranslateTransform/>
        			</TransformGroup>
        		</Image.RenderTransform>
        	</Image>
        	<Grid x:Name="Grid_Alignment" Grid.Column="1" Margin="-10,0,0,5.41" VerticalAlignment="Bottom">
        		<StackPanel x:Name="StackPanel_HelpButton" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
        			<TextBlock x:Name="TextBlock_Press" Text="{local:Loc Main.IDS_Press}" Style="{StaticResource HelpTextBlockStyle}"/>
        			<Grid Height="22" Width="22">
        				<Image x:Name="Image_ButtonGlow" Source="/Textures/Data_Bound/Help_Buttons/Button_Glow_Lg.png" Margin="-15"/>
        				<Image x:Name="Image_ButtonA" Source="/Textures/Data_Bound/Help_Buttons/Button_A.png"/>
        			</Grid>
        			<TextBlock x:Name="TextBlock_ToStart" Text="{local:Loc Main.IDS_To_Start}" Style="{StaticResource HelpTextBlockStyle}"/>
        		</StackPanel>
        	</Grid>
        	<Grid x:Name="Grid_ForzaStripe" Height="7" ClipToBounds="True" RenderTransformOrigin="0,0.5" Grid.Column="1" Grid.Row="1" VerticalAlignment="Top" Margin="0,4">
        		<Grid.RenderTransform>
        			<TransformGroup>
        				<ScaleTransform/>
        				<SkewTransform/>
        				<RotateTransform/>
        				<TranslateTransform/>
        			</TransformGroup>
        		</Grid.RenderTransform>
        		<Canvas x:Name="Canvas_ForzaStripe">
        			<Control x:Name="Control_ForzaStripe" Style="{StaticResource ForzaStripeControlStyle}"/>
        		</Canvas>
        	</Grid>
            <Image x:Name="Image_Ambient_ForzaStripe" Style="{StaticResource AmbientForzaStripeImageStyle}" Margin="-165,-33,0,0" Grid.Row="1" RenderTransformOrigin="0.5,0.5" Grid.ColumnSpan="1" Grid.Column="1" HorizontalAlignment="Left">
            	<Image.RenderTransform>
            		<TransformGroup>
            			<ScaleTransform/>
            			<SkewTransform/>
            			<RotateTransform/>
            			<TranslateTransform/>
            		</TransformGroup>
            	</Image.RenderTransform>
            </Image>
        </Grid>
        <Image x:Name="Image_Vignette" Source="/Textures/Backgrounds/E3_Start_Vignette.png" Opacity="0"/>
        <Image x:Name="Image_Hilite2" Source="/Textures/Backgrounds/E3_Start_Hilite2.png" Opacity="0"/>
        <Image x:Name="Image_Hilite1" Source="/Textures/Backgrounds/E3_Start_Hilite1.png" Opacity="0"/>
        
		<ProgressBar x:Name="IdleIndicator" Canvas.Right="95" Canvas.Bottom="52" IsIndeterminate="True" Style="{StaticResource SpinnyProgressStyle}" Height="56" Opacity="0"/>
        
        
        <!-- #################### EventFires #################### -->
        <local:EventFire x:Name="IdleEventFireSpin" TargetName="IdleIndicator"/>
        <local:EventFire x:Name="IdleEventFireHideSpin" TargetName="IdleIndicator"/>
        <!-- Start Storyboard -->
        <local:EventFire x:Name="EventFireStoryboard" TargetName="LayoutRoot"/>
	</local:ZPanel>
</Page>